/**
 * broadcast.js — Gửi tin nhắn HÀNG LOẠT tới mọi khách đã từng nhắn (remarketing).
 */
const { all, q } = require('../../db');
const { sendFB, sendZalo, sendTelegram } = require('../../webhook');

module.exports = function register(app, { auth, adminOnly, emit }) {

  // Đếm số người nhận tiềm năng (theo kênh)
  app.get('/api/broadcast/audience', auth, async (req, res) => {
    try {
      const rows = await all(
        `SELECT channel, COUNT(DISTINCT sender_id) n
         FROM messages WHERE shop_id=$1 AND sender_id IS NOT NULL AND channel <> 'fb_comment'
         GROUP BY channel`, [req.shopId]);
      res.json({ total: rows.reduce((s, r) => s + (+r.n), 0), byChannel: rows });
    } catch (e) { res.status(500).json({ error: e.message }); }
  });

  // Gửi hàng loạt
  app.post('/api/broadcast', auth, adminOnly, async (req, res) => {
    try {
      const text = (req.body.text || '').trim();
      if (!text) return res.status(400).json({ error: 'Thiếu nội dung tin' });

      const convs = await all(
        `SELECT DISTINCT ON (channel, sender_id) channel, sender_id
         FROM messages WHERE shop_id=$1 AND sender_id IS NOT NULL AND channel <> 'fb_comment'
         ORDER BY channel, sender_id, created_at DESC`, [req.shopId]);

      const tokRows = await all("SELECT channel, page_token FROM channel_tokens WHERE shop_id=$1", [req.shopId]);
      const tokens = Object.fromEntries(tokRows.map(r => [r.channel, r.page_token]));

      let sent = 0, pushed = 0;
      for (const c of convs) {
        // Lưu vào hội thoại (hiện ở Hộp thư)
        await q('INSERT INTO messages (shop_id,channel,direction,text,sender_id,staff_reply) VALUES ($1,$2,$3,$4,$5,TRUE)',
          [req.shopId, c.channel, 'out', text, c.sender_id]);
        // Đẩy thật sang kênh nếu có token
        const tok = tokens[c.channel];
        if (tok && c.sender_id) {
          if (c.channel === 'facebook')      { sendFB(tok, c.sender_id, text); pushed++; }
          else if (c.channel === 'zalo')     { sendZalo(tok, c.sender_id, text); pushed++; }
          else if (c.channel === 'telegram') { sendTelegram(tok, c.sender_id, text); pushed++; }
        }
        sent++;
      }
      emit(req.shopId, 'broadcast:sent', { sent });
      res.json({ ok: true, sent, pushed });
    } catch (e) { res.status(500).json({ error: e.message }); }
  });
};
